# AP Agent Environment Variables
# Copy this file to .env and fill in your actual values.
# Never commit .env (it's in .gitignore), only .env.example gets committed.

# LLM Provider Configuration
# Choose "anthropic" or "openai" (openai works for DeepSeek and other OpenAI-compatible APIs)
LLM_PROVIDER=anthropic

# API Keys (set the one you're using)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic Base URL (optional)
# Leave blank for official Anthropic endpoint
# For DeepSeek's Anthropic-compatible endpoint: https://api.deepseek.com/anthropic
ANTHROPIC_BASE_URL=

# OpenAI-Compatible Provider Settings (optional, only needed if LLM_PROVIDER=openai)
# For DeepSeek: https://api.deepseek.com
# For OpenAI: leave blank or omit
LLM_BASE_URL=

# Model Selection (optional, uses sensible defaults if not set)
# Check your provider's console for current model IDs
# Examples:
#   Anthropic: claude-sonnet-4-20250514, claude-opus-4-20250514, claude-haiku-4
#   OpenAI: gpt-4, gpt-4-turbo, gpt-4o
#   DeepSeek: deepseek-chat, deepseek-coder
ANTHROPIC_MODEL=your-anthropic-model-id
LLM_MODEL=your-openai-compatible-model-id

# Database (when you add it later)
# DATABASE_URL=sqlite:///data/apagent.db

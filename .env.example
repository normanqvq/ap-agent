# AP Agent Environment Variables
# Copy this file to .env and fill in your actual values.
# Never commit .env (it's in .gitignore), only .env.example gets committed.

# LLM Provider Selection
# One of: anthropic | deepseek | groq | openai | bedrock
#   anthropic - native Anthropic SDK (also serves DeepSeek's Anthropic endpoint,
#               see ANTHROPIC_BASE_URL below)
#   deepseek  - DeepSeek native endpoint (OpenAI-compatible), uses DEEPSEEK_API_KEY
#   groq      - Groq endpoint (OpenAI-compatible), uses GROQ_API_KEY
#   openai    - OpenAI itself, or any OpenAI-compatible endpoint via LLM_BASE_URL
#   bedrock   - Claude on AWS Bedrock via the anthropic SDK (AnthropicBedrock).
#               Needs the AWS extra: pip install "anthropic[aws]". See the
#               AWS section at the bottom.
LLM_PROVIDER=deepseek

# API Keys — each provider reads its own key, so several can coexist here
# and switching providers is just the LLM_PROVIDER line above.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Model overrides (optional — sensible defaults per provider if unset)
#   anthropic default: claude-sonnet-4-20250514
#   deepseek  default: deepseek-chat
#   groq      default: llama-3.3-70b-versatile
#   openai    default: gpt-4o
ANTHROPIC_MODEL=
DEEPSEEK_MODEL=
GROQ_MODEL=
LLM_MODEL=
#   bedrock   default: global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL=

# Anthropic Base URL (optional)
# Leave blank for the official Anthropic endpoint.
# For DeepSeek's Anthropic-compatible endpoint: https://api.deepseek.com/anthropic
ANTHROPIC_BASE_URL=

# OpenAI-compatible Base URL override (optional)
# Only relevant when LLM_PROVIDER=openai and you target a non-OpenAI endpoint.
# deepseek/groq presets set their own base URLs automatically.
LLM_BASE_URL=

# AWS Bedrock (only when LLM_PROVIDER=bedrock)
# Credentials are read from the standard AWS chain — NOT by this app. Put them
# here (this .env is gitignored) OR export them in your shell OR use ~/.aws.
# The workshop account is an IAM user (no SSO) in ap-southeast-1.
AWS_DEFAULT_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Database (when you add it later)
# DATABASE_URL=sqlite:///data/apagent.db

# Chat-confirmed goods receipts (optional)
# Leave TELEGRAM_BOT_TOKEN blank and the bot simply never starts; the web
# console runs exactly as before. Set it and a background poller joins the
# groups listed in data/chat/roster.json.
#
# Get the token from @BotFather. Then -- this part is easy to miss -- send
# BotFather /setprivacy for your bot and turn privacy mode OFF. With it on,
# the bot only receives messages that @mention it, which loses the
# surrounding conversation, and the surrounding conversation is the part
# that actually says what arrived.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Where the confirmer allowlist lives. Defaults to data/chat/roster.json,
# which is gitignored — copy data/chat/roster.example.json to it and fill in
# your real chat and user ids (scripts/telegram_setup.py prints them).
APAGENT_CHAT_ROSTER=

# Vendor email intake (optional)
# Unset IMAP and no mail poller starts; unset SMTP and nothing is ever sent.
# Both absent is a valid install that behaves exactly as before this feature.
#
# Gmail: switch on 2-step verification, then create an app password at
# myaccount.google.com/apppasswords. IMAP no longer has an on/off switch --
# Google removed it in 2025 and it is always on. Paste the app password with
# or without its spaces; they are stripped.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The address vendors reply to. Their replies are matched by message headers,
# never by the subject line.
APAGENT_MAIL_FROM=
# vendor_id -> address. Doubles as the send allowlist and the inbound sender
# check. Defaults to data/email/vendors.json (gitignored; copy the example).
APAGENT_VENDOR_DIRECTORY=
# Set to 1 to re-send, at every startup, the queries for whatever the
# committed cache already has at EMAIL. Off by default: idempotency is
# per-process, so this mails the same vendor the same query once per
# restart. Leaving it off costs nothing -- a decision dispatches its own
# query when it is made.
APAGENT_MAIL_DISPATCH_AT_BOOT=
